<?xml version="1.0"?>
<robot name="advika_3_0" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       ADVIKA 3.0 - Gazebo-Ready URDF
       ROS2 Humble | Gazebo Fortress/Garden
       Differential Drive Robot
       Chassis: 200x150x3mm | Wheel: D60mm | Track: 160mm
  ============================================================ -->

  <!-- GAZEBO PHYSICS PROPERTIES -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find advika_description)/config/advika_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- DIFFERENTIAL DRIVE PLUGIN -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_diameter>0.060</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ============================================================
       LINKS
  ============================================================ -->

  <!-- BASE FOOTPRINT -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.030" rpy="0 0 0"/>
  </joint>

  <!-- CHASSIS -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://advika_description/meshes/visual/advika_chassis.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="dark_grey"><color rgba="0.31 0.31 0.31 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.200 0.150 0.003"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0015" rpy="0 0 0"/>
      <mass value="0.450"/>
      <inertia ixx="8.44e-4" ixy="0" ixz="0" iyy="1.51e-3" iyz="0" izz="2.11e-3"/>
    </inertial>
  </link>
  <gazebo reference="base_link">
    <material>Gazebo/DarkGray</material>
    <mu1>0.8</mu1><mu2>0.6</mu2>
  </gazebo>

  <!-- WHEEL LEFT -->
  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><mesh filename="package://advika_description/meshes/visual/advika_wheel_hub_L.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.030" length="0.010"/></geometry>
    </collision>
    <inertial>
      <mass value="0.120"/>
      <inertia ixx="2.88e-5" ixy="0" ixz="0" iyy="2.88e-5" iyz="0" izz="5.40e-5"/>
    </inertial>
  </link>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="wheel_left_link"/>
    <origin xyz="0.000  0.080  0.000" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit effort="10" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>
  <gazebo reference="wheel_left_link">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1><mu2>1.2</mu2>
    <kp>10000000.0</kp><kd>1.0</kd>
  </gazebo>

  <!-- WHEEL RIGHT -->
  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><mesh filename="package://advika_description/meshes/visual/advika_wheel_hub_R.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.030" length="0.010"/></geometry>
    </collision>
    <inertial>
      <mass value="0.120"/>
      <inertia ixx="2.88e-5" ixy="0" ixz="0" iyy="2.88e-5" iyz="0" izz="5.40e-5"/>
    </inertial>
  </link>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="wheel_right_link"/>
    <origin xyz="0.000 -0.080  0.000" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit effort="10" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>
  <gazebo reference="wheel_right_link">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1><mu2>1.2</mu2>
    <kp>10000000.0</kp><kd>1.0</kd>
  </gazebo>

  <!-- CASTER FRONT -->
  <link name="caster_front_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <inertial>
      <mass value="0.050"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front_link"/>
    <origin xyz="0.080 0 -0.015" rpy="0 0 0"/>
  </joint>
  <gazebo reference="caster_front_link">
    <material>Gazebo/Black</material>
    <mu1>0.001</mu1><mu2>0.001</mu2>
  </gazebo>

  <!-- CASTER REAR -->
  <link name="caster_rear_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <inertial>
      <mass value="0.050"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear_link"/>
    <origin xyz="-0.080 0 -0.015" rpy="0 0 0"/>
  </joint>
  <gazebo reference="caster_rear_link">
    <material>Gazebo/Black</material>
    <mu1>0.001</mu1><mu2>0.001</mu2>
  </gazebo>

  <!-- LIDAR TOWER -->
  <link name="lidar_tower_link">
    <visual>
      <origin xyz="0 0 0.040" rpy="0 0 0"/>
      <geometry><mesh filename="package://advika_description/meshes/visual/advika_lidar_tower.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="lt_grey"><color rgba="0.8 0.8 0.8 1"/></material>
    </visual>
    <inertial><mass value="0.100"/><inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="5e-5"/></inertial>
  </link>
  <joint name="lidar_tower_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_tower_link"/>
    <origin xyz="0 0 0.003" rpy="0 0 0"/>
  </joint>

  <!-- LIDAR SENSOR LINK -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.020" length="0.030"/></geometry>
    <material name="silver"><color rgba="0.75 0.75 0.75 1"/></material></visual>
    <inertial><mass value="0.170"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_tower_link"/><child link="lidar_link"/>
    <origin xyz="0 0 0.083" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.10</min><max>10.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU -->
  <link name="imu_link">
    <visual><geometry><box size="0.030 0.030 0.008"/></geometry>
    <material name="purple"><color rgba="0.6 0.2 0.8 1"/></material></visual>
    <inertial><mass value="0.030"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0.007" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <update_rate>100</update_rate>
      <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros><remapping>~/out:=imu</remapping></ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- CAMERA HORIZON -->
  <link name="camera_horizon_link">
    <visual><geometry><box size="0.050 0.030 0.020"/></geometry>
    <material name="amber"><color rgba="0.8 0.6 0.0 1"/></material></visual>
    <inertial><mass value="0.060"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="camera_horizon_joint" type="fixed">
    <parent link="base_link"/><child link="camera_horizon_link"/>
    <origin xyz="0.080 0 0.013" rpy="0 0 0"/>
  </joint>
  <gazebo reference="camera_horizon_link">
    <sensor type="camera" name="camera_horizon">
      <update_rate>30</update_rate>
      <camera name="horizon_cam">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <camera_name>camera_horizon</camera_name>
        <frame_name>camera_horizon_link</frame_name>
        <image_topic_name>camera/horizon/image_raw</image_topic_name>
        <camera_info_topic_name>camera/horizon/camera_info</camera_info_topic_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- CAMERA FLOOR -->
  <link name="camera_floor_link">
    <visual><geometry><box size="0.040 0.025 0.015"/></geometry>
    <material name="amber"><color rgba="0.8 0.6 0.0 1"/></material></visual>
    <inertial><mass value="0.050"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="camera_floor_joint" type="fixed">
    <parent link="base_link"/><child link="camera_floor_link"/>
    <origin xyz="0.090 0 0.005" rpy="0 0.524 0"/>
  </joint>
  <gazebo reference="camera_floor_link">
    <sensor type="camera" name="camera_floor">
      <update_rate>30</update_rate>
      <camera name="floor_cam">
        <horizontal_fov>1.5707963</horizontal_fov>
        <image><width>320</width><height>240</height><format>R8G8B8</format></image>
        <clip><near>0.01</near><far>2.0</far></clip>
      </camera>
      <plugin name="camera_floor_controller" filename="libgazebo_ros_camera.so">
        <camera_name>camera_floor</camera_name>
        <frame_name>camera_floor_link</frame_name>
        <image_topic_name>camera/floor/image_raw</image_topic_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- BATTERY TRAY -->
  <link name="battery_tray_link">
    <visual><geometry><mesh filename="package://advika_description/meshes/visual/advika_battery_tray.stl" scale="0.001 0.001 0.001"/></geometry>
    <material name="orange"><color rgba="0.86 0.31 0 1"/></material></visual>
    <inertial><mass value="0.500"/><inertia ixx="3.0e-3" ixy="0" ixz="0" iyy="5.0e-3" iyz="0" izz="7.0e-3"/></inertial>
  </link>
  <joint name="battery_tray_joint" type="fixed">
    <parent link="base_link"/><child link="battery_tray_link"/>
    <origin xyz="-0.040 0 0.013" rpy="0 0 0"/>
  </joint>

  <!-- ESP32 -->
  <link name="esp32_link">
    <visual><geometry><mesh filename="package://advika_description/meshes/visual/advika_esp32_enclosure.stl" scale="0.001 0.001 0.001"/></geometry>
    <material name="cyan"><color rgba="0.04 0.71 0.71 1"/></material></visual>
    <inertial><mass value="0.080"/><inertia ixx="3e-5" ixy="0" ixz="0" iyy="3e-5" iyz="0" izz="3e-5"/></inertial>
  </link>
  <joint name="esp32_joint" type="fixed">
    <parent link="base_link"/><child link="esp32_link"/>
    <origin xyz="-0.070 -0.040 0.015" rpy="0 0 0"/>
  </joint>

  <!-- BUMPER FRONT -->
  <link name="bumper_front_link">
    <visual><geometry><mesh filename="package://advika_description/meshes/visual/advika_bumper_front.stl" scale="0.001 0.001 0.001"/></geometry>
    <material name="red"><color rgba="0.78 0.12 0.12 1"/></material></visual>
    <collision><geometry><box size="0.210 0.015 0.010"/></geometry></collision>
    <inertial><mass value="0.090"/><inertia ixx="3e-5" ixy="0" ixz="0" iyy="3e-5" iyz="0" izz="3e-5"/></inertial>
  </link>
  <joint name="bumper_front_joint" type="fixed">
    <parent link="base_link"/><child link="bumper_front_link"/>
    <origin xyz="0.105 0 0.005" rpy="0 0 0"/>
  </joint>

  <!-- BUMPER REAR -->
  <link name="bumper_rear_link">
    <visual><geometry><mesh filename="package://advika_description/meshes/visual/advika_bumper_rear.stl" scale="0.001 0.001 0.001"/></geometry>
    <material name="red"><color rgba="0.78 0.12 0.12 1"/></material></visual>
    <collision><geometry><box size="0.210 0.015 0.010"/></geometry></collision>
    <inertial><mass value="0.090"/><inertia ixx="3e-5" ixy="0" ixz="0" iyy="3e-5" iyz="0" izz="3e-5"/></inertial>
  </link>
  <joint name="bumper_rear_joint" type="fixed">
    <parent link="base_link"/><child link="bumper_rear_link"/>
    <origin xyz="-0.105 0 0.005" rpy="0 0 0"/>
  </joint>

</robot>
