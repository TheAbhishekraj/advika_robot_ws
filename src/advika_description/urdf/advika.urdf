<?xml version="1.0"?>
<robot name="advika">
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="white"><color rgba="0.9 0.9 0.9 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.3 0.8 1.0"/></material>
  <material name="green"><color rgba="0.1 0.7 0.2 1.0"/></material>
  <material name="transparent"><color rgba="0.5 0.5 0.5 0.3"/></material>

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== BASE LINK ==================== -->
  <link name="base_link">
    <visual><origin xyz="0 0 0.075" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_base_plate.stl"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0.075" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_base_plate.stl"/></geometry></collision>
    <inertial><origin xyz="0 0 0.075" rpy="0 0 0"/><mass value="2.0"/><inertia ixx="0.0125" ixy="0" ixz="0" iyy="0.0165" iyz="0" izz="0.0245"/></inertial>
  
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_mid_frame.stl"/></geometry><material name="blue"/></visual>
    <visual><origin xyz="0.130 0 0.03" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_bumper_front.stl"/></geometry><material name="red"/></visual>
    <visual><origin xyz="-0.130 0 0.03" rpy="0 0 3.14159"/><geometry><mesh filename="package://advika_cad/meshes/advika30_bumper_rear.stl"/></geometry><material name="red"/></visual>

  </link>

  <link name="left_wheel">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_wheel_hub_L.stl"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_wheel_hub_L.stl"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.0325" length="0.03"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.15"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00008"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.10 0.0325" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/></joint>

  <link name="right_wheel">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_wheel_hub_R.stl"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_wheel_hub_R.stl"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.0325" length="0.03"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.15"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00008"/></inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.10 0.0325" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/></joint>

  <link name="caster_wheel">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_caster_housing_F.stl"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_caster_housing_F.stl"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.015"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="caster_wheel_joint" type="fixed"><parent link="base_link"/><child link="caster_wheel"/><origin xyz="0.12 0 0.015" rpy="0 0 0"/></joint>

  <link name="caster_wheel_rear">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_caster_housing_R.stl"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_caster_housing_R.stl"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.015"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="caster_wheel_rear_joint" type="fixed"><parent link="base_link"/><child link="caster_wheel_rear"/><origin xyz="-0.12 0 0.015" rpy="0 0 0"/></joint>

  <link name="lidar_tower">
    <visual><origin xyz="0 0 -0.15" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_top_cover.stl"/></geometry><material name="white"/></visual>
    <collision><origin xyz="0 0 -0.15" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_top_cover.stl"/></geometry><material name="white"/></visual>
    <collision><origin xyz="0 0 0.04" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.08"/></geometry></collision>
    <inertial><origin xyz="0 0 0.04" rpy="0 0 0"/><mass value="0.1"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="lidar_tower_joint" type="fixed"><parent link="base_link"/><child link="lidar_tower"/><origin xyz="0 0 0.15" rpy="0 0 0"/></joint>

  <link name="lidar_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.025" length="0.03"/></geometry><material name="red"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.025" length="0.03"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed"><parent link="lidar_tower"/><child link="lidar_link"/><origin xyz="0 0 0.065" rpy="0 0 0"/></joint>

  <link name="horizon_camera_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_camera_mount_front.stl"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_camera_mount_front.stl"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.02 0.04 0.02"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.02"/><inertia ixx="0.000003" ixy="0" ixz="0" iyy="0.000003" iyz="0" izz="0.000003"/></inertial>
  </link>
  <joint name="horizon_camera_joint" type="fixed"><parent link="base_link"/><child link="horizon_camera_link"/><origin xyz="0.14 0 0.12" rpy="0 0 0"/></joint>

  <link name="floor_camera_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_camera_mount_floor.stl"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_camera_mount_floor.stl"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.02 0.04 0.02"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.02"/><inertia ixx="0.000003" ixy="0" ixz="0" iyy="0.000003" iyz="0" izz="0.000003"/></inertial>
  </link>
  <joint name="floor_camera_joint" type="fixed"><parent link="base_link"/><child link="floor_camera_link"/><origin xyz="0.12 0 0.02" rpy="0 0.785 0"/></joint>

  <link name="tof_array_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.04 0.04 0.01"/></geometry><material name="green"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.04 0.04 0.01"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.01"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial>
  </link>
  <joint name="tof_array_joint" type="fixed"><parent link="base_link"/><child link="tof_array_link"/><origin xyz="0.15 0 0.08" rpy="0 0 0"/></joint>

  <link name="imu_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.02 0.02 0.005"/></geometry><material name="transparent"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.02 0.02 0.005"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.005"/><inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.0000001" iyz="0" izz="0.0000001"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.08" rpy="0 0 0"/></joint>

  <link name="toff_bar_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_tof_bar.stl"/></geometry><material name="green"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.08 0.015 0.003"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.01"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial>
  </link>
  <joint name="toff_bar_joint" type="fixed"><parent link="base_link"/><child link="toff_bar_link"/><origin xyz="0.15 0 0.05" rpy="0 0 0"/></joint>

  <link name="display_board_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_display.stl"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.027 0.028 0.0015"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.005"/><inertia ixx="0.0000005" ixy="0" ixz="0" iyy="0.0000005" iyz="0" izz="0.0000005"/></inertial>
  </link>
  <joint name="display_board_joint" type="fixed"><parent link="base_link"/><child link="display_board_link"/><origin xyz="0 0 0.153" rpy="0 0 0"/></joint>

  <link name="lidar_disk_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_lidar_disk.stl"/></geometry><material name="white"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.012"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.03"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
  </link>
  <joint name="lidar_disk_joint" type="fixed"><parent link="lidar_link"/><child link="lidar_disk_link"/><origin xyz="0 0 0.02" rpy="0 0 0"/></joint>

  <link name="imu_board_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://advika_cad/meshes/advika30_imu_board.stl"/></geometry><material name="green"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.02 0.027 0.0016"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.005"/><inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.0000001" iyz="0" izz="0.0000001"/></inertial>
  </link>
  <joint name="imu_board_joint" type="fixed"><parent link="base_link"/><child link="imu_board_link"/><origin xyz="0 0 0.08" rpy="0 0 0"/></joint>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.20</wheel_separation>
      <wheel_radius>0.0325</wheel_radius>
      <max_linear_velocity>0.5</max_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/advika/cmd_vel</topic>
      <odom_topic>/advika/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/advika/imu/data</topic>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/advika/scan</topic>
      <visualize>true</visualize>
      <update_rate>20</update_rate>
      <lidar>
        <scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>5.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="horizon_camera_link">
    <sensor name="horizon_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/advika/horizon_camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.22</horizontal_fov>
        <image><width>320</width><height>240</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>100</far></clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="floor_camera_link">
    <sensor name="floor_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/advika/floor_camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.22</horizontal_fov>
        <image><width>320</width><height>240</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>10</far></clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="base_link">
    <mu1>0.5</mu1><mu2>0.5</mu2><self_collide>false</self_collide><gravity>true</gravity>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>0.8</mu1><mu2>0.8</mu2><self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>0.8</mu1><mu2>0.8</mu2><self_collide>false</self_collide>
  </gazebo>
</robot>
