<?xml version="1.0"?>
<sdf version="1.6">
  <world name="3bhk_house">
    
    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    
    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.45 1</ambient>
      <background>0.9 0.87 0.82 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    
    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Sun -->
    <light name="sun" type="directional">
      <pose>10 10 15 0 0 0</pose>
      <diffuse>1 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.45 0.1 -0.88</direction>
      <cast_shadows>true</cast_shadows>
      <shadow><resolution>2048</resolution><near>0.5</near><far>30</far></shadow>
    </light>
    
    <!-- Indoor lights -->
    <light name="living_light" type="point">
      <pose>0 0 2.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <light name="kitchen_light" type="point">
      <pose>3.5 -1.5 2.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <attenuation><range>6</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <light name="bedroom_light" type="point">
      <pose>-2 3.5 2.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <attenuation><range>6</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    
    <!-- ==================== OUTER WALLS ==================== -->
    <!-- North wall (Living room + Kitchen) -->
    <model name="wall_north_living"><static>true</static><pose>0 2.5 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6.2 0.1 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.2 0.1 2.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>
    
    <!-- South wall -->
    <model name="wall_south"><static>true</static><pose>0 -2.5 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6.2 0.1 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.2 0.1 2.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>
    
    <!-- East wall (Living side) -->
    <model name="wall_east_living"><static>true</static><pose>3.1 0 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.1 5.0 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 5.0 2.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>
    
    <!-- East wall (Kitchen extension) -->
    <model name="wall_east_kitchen"><static>true</static><pose>3.1 -1.8 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.1 1.4 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 1.4 2.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>
    
    <!-- West wall (Living) -->
    <model name="wall_west_living"><static>true</static><pose>-3.1 0.75 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.1 3.5 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 3.5 2.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>
    
    <!-- West wall (Bedroom side) -->
    <model name="wall_west_bed"><static>true</static><pose>-3.1 3.5 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.1 2.0 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 2.0 2.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>
    
    <!-- ==================== INNER WALLS ==================== -->
    <!-- Living-Kitchen divider (with doorway at x=2.5) -->
    <model name="wall_living_kitchen_1"><static>true</static><pose>1.0 -1.8 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>3.0 0.1 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3.0 0.1 2.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>
    
    <!-- Hallway divider -->
    <model name="wall_hallway_north"><static>true</static><pose>-1.5 2.5 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>3.2 0.1 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3.2 0.1 2.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>
    
    <!-- Bedroom 1 divider (Master) -->
    <model name="wall_bed1_south"><static>true</static><pose>-1.5 1.8 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>3.2 0.1 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3.2 0.1 2.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>
    
    <!-- Bedroom 2 divider -->
    <model name="wall_bed2_south"><static>true</static><pose>-1.5 0.6 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>3.2 0.1 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3.2 0.1 2.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>
    
    <!-- Living room floor -->
    <model name="living_floor">
      <static>true</static><pose>0 0 0.002 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6.0 5.0 0.004</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.0 5.0 0.004</size></box></geometry>
          <material><ambient>0.5 0.3 0.15 1</ambient><diffuse>0.65 0.4 0.2 1</diffuse><specular>0.1 0.1 0.1 1</specular>
            <pbr><metallic>0</metallic><roughness>0.7</roughness></pbr></material></visual></link>
    </model>

    <!-- Coffee table (center of living room) -->
    <model name="coffee_table">
      <static>true</static><pose>0 0 0.25 0 0 0</pose>
      <link name="wood_base">
        <collision name="c"><geometry><box><size>0.9 0.5 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.9 0.5 0.05</size></box></geometry>
          <material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.5 0.28 0.12 1</diffuse><specular>0.2 0.15 0.1 1</specular></material></visual>
      </link>
      <link name="leg_br"><pose>0.35 0.18 -0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.05 0.05 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.44</size></box></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.12 1</diffuse></material></visual>
      </link>
      <link name="leg_bl"><pose>-0.35 0.18 -0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.05 0.05 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.44</size></box></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.12 1</diffuse></material></visual>
      </link>
      <link name="leg_fr"><pose>0.35 -0.18 -0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.05 0.05 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.44</size></box></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.12 1</diffuse></material></visual>
      </link>
      <link name="leg_fl"><pose>-0.35 -0.18 -0.22 0 0 0</pose><collision name="c"><geometry><box><size>0.05 0.05 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.44</size></box></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.12 1</diffuse></material></visual>
      </link>
    </model>
    
  </world>
</sdf>
