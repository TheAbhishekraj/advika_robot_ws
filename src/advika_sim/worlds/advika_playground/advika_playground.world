<?xml version="1.0"?>
<sdf version="1.6">
  <world name="advika_playground">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    
    <!-- Light Source -->
    <light name="sun" type="directional">
      <pose>5 5 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    
    <!-- Ground Plane -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    
    <!-- Playground Boundary (optional cones) -->
    <model name="cone_1"><static>true</static><pose>2 2 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><cone><radius>0.2</radius><length>0.5</length></cone></geometry></collision>
      <visual><geometry><cone><radius>0.2</radius><length>0.5</length></cone></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
      
    <model name="cone_2"><static>true</static><pose>2 -2 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><cone><radius>0.2</radius><length>0.5</length></cone></geometry></collision>
      <visual><geometry><cone><radius>0.2</radius><length>0.5</length></cone></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
      
    <model name="cone_3"><static>true</static><pose>-2 2 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><cone><radius>0.2</radius><length>0.5</length></cone></geometry></collision>
      <visual><geometry><cone><radius>0.2</radius><length>0.5</length></cone></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>
      
    <model name="cone_4"><static>true</static><pose>-2 -2 0.25 0 0 0</pose>
      <link name="link"><collision><geometry><cone><radius>0.2</radius><length>0.5</length></cone></geometry></collision>
      <visual><geometry><cone><radius>0.2</radius><length>0.5</length></cone></geometry><material><ambient>1 0.5 0 1</ambient></material></visual></link></model>

  </world>
</sdf>
