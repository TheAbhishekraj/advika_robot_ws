<?xml version="1.0"?>
<sdf version="1.6">
  <world name="living_room">
    
    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    
    <!-- Scene -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    
    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Sun -->
    <light name="sun" type="directional">
      <pose>5 5 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    
    <!-- Indoor light -->
    <light name="living_light" type="point">
      <pose>0 0 2.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>

    <!-- Simple Room Walls (6m x 6m) -->
    <model name="wall_north">
      <static>true</static><pose>0 3 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6.2 0.2 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.2 0.2 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link>
    </model>
    
    <model name="wall_south">
      <static>true</static><pose>0 -3 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6.2 0.2 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.2 0.2 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link>
    </model>
    
    <model name="wall_east">
      <static>true</static><pose>3 0 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 6.0 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 6.0 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link>
    </model>
    
    <model name="wall_west">
      <static>true</static><pose>-3 0 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 6.0 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 6.0 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link>
    </model>
    
    <!-- Simple Furniture (Boxes to avoid Fuel download crashes) -->
    <model name="coffee_table">
      <static>true</static><pose>0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.6 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.0 0.6 0.5</size></box></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.5 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <model name="sofa">
      <static>true</static><pose>0 1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 0.8 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.0 0.8 0.8</size></box></geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient></material>
        </visual>
      </link>
    </model>
    
    <model name="tv_stand">
      <static>true</static><pose>0 -2.8 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.4 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 0.4 0.6</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
