<?xml version="1.0"?>
<sdf version="1.6">
  <world name="living_room">
    
    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    
    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.45 1</ambient>
      <background>0.9 0.87 0.82 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    
    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ── SUN WITH SHADOWS ── -->
    <light name="sun" type="directional">
      <pose>10 10 15 0 0 0</pose>
      <diffuse>1 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.45 0.1 -0.88</direction>
      <cast_shadows>true</cast_shadows>
      <shadow><resolution>2048</resolution><near>0.5</near><far>30</far></shadow>
    </light>

    <!-- ── INDOOR LIGHTING (warm, layered) ── -->
    <light name="ambient_ceiling" type="point">
      <pose>0 0 2.3 0 0 0</pose>
      <diffuse>1 0.9 0.75 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>6</range><constant>0.4</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="ambient_ceiling_2" type="point">
      <pose>1.5 0 2.3 0 0 0</pose>
      <diffuse>1 0.88 0.72 1</diffuse>
      <attenuation><range>4</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="ambient_ceiling_3" type="point">
      <pose>-1.5 0 2.3 0 0 0</pose>
      <diffuse>1 0.88 0.72 1</diffuse>
      <attenuation><range>4</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- Simple Room Walls (6m x 6m) -->
    <model name="wall_north">
      <static>true</static><pose>0 3 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6.2 0.2 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.2 0.2 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link>
    </model>
    
    <model name="wall_south">
      <static>true</static><pose>0 -3 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6.2 0.2 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.2 0.2 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link>
    </model>
    
    <model name="wall_east">
      <static>true</static><pose>3 0 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 6.0 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 6.0 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link>
    </model>
    
    <model name="wall_west">
      <static>true</static><pose>-3 0 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 6.0 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 6.0 2.5</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link>
    </model>
    
    <!-- ── WALLS (warm off-white plaster) ── -->
    <model name="wall_north">
      <static>true</static><pose>0 3 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6.2 0.2 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.2 0.2 2.5</size></box></geometry>
        <material><ambient>0.92 0.90 0.86 1</ambient><diffuse>0.95 0.93 0.89 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual></link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -3 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6.2 0.2 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.2 0.2 2.5</size></box></geometry>
        <material><ambient>0.92 0.90 0.86 1</ambient><diffuse>0.95 0.93 0.89 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual></link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>3 0 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 6.0 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 6.0 2.5</size></box></geometry>
        <material><ambient>0.92 0.90 0.86 1</ambient><diffuse>0.95 0.93 0.89 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual></link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-3 0 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 6.0 2.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 6.0 2.5</size></box></geometry>
        <material><ambient>0.92 0.90 0.86 1</ambient><diffuse>0.95 0.93 0.89 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual></link>
    </model>

    <!-- ── FLOOR (wooden planks) ── -->
    <model name="floor_wood">
      <static>true</static><pose>0 0 0.002 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.0 6.0 0.004</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.0 6.0 0.004</size></box></geometry>
          <material>
            <ambient>0.5 0.3 0.15 1</ambient>
            <diffuse>0.65 0.4 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr><metallic>0</metallic><roughness>0.7</roughness></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── COFFEE TABLE (teak wood + glass top) ── -->
    <model name="coffee_table">
      <static>true</static><pose>0 0 0.25 0 0 0</pose>
      <link name="wood_base">
        <collision name="c"><geometry><box><size>0.9 0.5 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.9 0.5 0.05</size></box></geometry>
          <material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.5 0.28 0.12 1</diffuse><specular>0.2 0.15 0.1 1</specular>
            <pbr><metallic>0</metallic><roughness>0.6</roughness></pbr></material></visual>
      </link>
      <link name="leg_br">
        <pose>0.35 0.18 -0.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.44</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.12 1</diffuse></material></visual>
      </link>
      <link name="leg_bl">
        <pose>-0.35 0.18 -0.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.44</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.12 1</diffuse></material></visual>
      </link>
      <link name="leg_fr">
        <pose>0.35 -0.18 -0.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.44</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.12 1</diffuse></material></visual>
      </link>
      <link name="leg_fl">
        <pose>-0.35 -0.18 -0.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.44</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── SOFA (velvet navy + legs) ── -->
    <model name="sofa">
      <static>true</static><pose>0 1.8 0.45 0 0 0</pose>
      <link name="seat">
        <collision name="c"><geometry><box><size>2.0 0.75 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.75 0.4</size></box></geometry>
          <material><ambient>0.15 0.15 0.45 1</ambient><diffuse>0.2 0.22 0.55 1</diffuse><specular>0.05 0.05 0.1 1</specular>
            <pbr><metallic>0</metallic><roughness>0.9</roughness></pbr></material></visual>
      </link>
      <link name="backrest">
        <pose>0 0.33 0.38 0 -0.15 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.2 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.2 0.7</size></box></geometry>
          <material><ambient>0.15 0.15 0.45 1</ambient><diffuse>0.2 0.22 0.55 1</diffuse><specular>0.05 0.05 0.1 1</specular>
            <pbr><metallic>0</metallic><roughness>0.9</roughness></pbr></material></visual>
      </link>
    </model>

    <!-- ── TV STAND (black + glass doors) ── -->
    <model name="tv_stand">
      <static>true</static><pose>0 -2.8 0.3 0 0 0</pose>
      <link name="body">
        <collision name="c"><geometry><box><size>1.5 0.4 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.4 0.6</size></box></geometry>
          <material><ambient>0.08 0.08 0.1 1</ambient><diffuse>0.12 0.12 0.15 1</diffuse><specular>0.3 0.3 0.35 1</specular>
            <pbr><metallic>0.1</metallic><roughness>0.3</roughness></pbr></material></visual>
      </link>
      <link name="tv_screen">
        <pose>0 0 0.65 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.2 0.05 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.05 0.7</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
      </link>
    </model>

    <!-- ── BOOKSHELF (right wall) ── -->
    <model name="bookshelf">
      <static>true</static><pose>2.7 1.0 1.0 0 0 0</pose>
      <link name="frame">
        <collision name="c"><geometry><box><size>0.3 0.8 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.8 2.0</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      </link>
    </model>

    <!-- ── PLANT (corner) ── -->
    <model name="plant">
      <static>true</static><pose>-2.7 2.7 0 0 0 0</pose>
      <link name="pot">
        <collision name="c"><geometry><cylinder radius="0.18" length="0.3"/></geometry></collision>
        <visual name="v"><geometry><cylinder radius="0.18" length="0.3"/></geometry>
          <material><ambient>0.6 0.35 0.2 1</ambient><diffuse>0.7 0.42 0.25 1</diffuse></material></visual>
      </link>
      <link name="foliage">
        <pose>0 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><sphere radius="0.35"/></geometry></collision>
        <visual name="v"><geometry><sphere radius="0.35"/></geometry>
          <material><ambient>0.1 0.45 0.1 1</ambient><diffuse>0.18 0.6 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── RUG (under coffee table) ── -->
    <model name="rug">
      <static>true</static><pose>0 0 0.003 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 1.0 0.005</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 1.0 0.005</size></box></geometry>
          <material><ambient>0.6 0.15 0.15 1</ambient><diffuse>0.75 0.2 0.2 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metallic>0</metallic><roughness>1.0</roughness></pbr></material></visual>
      </link>
    </model>

  </world>
</sdf>
