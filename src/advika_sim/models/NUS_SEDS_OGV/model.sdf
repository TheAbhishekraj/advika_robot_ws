<?xml version="1.0"?>
<sdf version="1.6">
  <model name="NUS_SEDS_OMNIDIRECTIONAL_GROUND_VEHICLE">
    <static>true</static>
    <link name="base_link">
      <visual name= "Body_visual">
        <geometry>
          <mesh>
            <uri>model://OGV/meshes/ogv.dae</uri>
            <submesh>
              <name>Body</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>model://OGV/materials/textures/OGV_Albedo.jpg</albedo_map>
              <metal_map>model://OGV/materials/textures/OGV_Metalness.jpg</metal_map>
              <roughness_map>model://OGV/materials/textures/OGV_Roughness.jpg</roughness_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="collision">
         <geometry><box><size>0.4 0.3 0.2</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
