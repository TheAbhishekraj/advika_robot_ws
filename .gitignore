# =============================================================================
# Advika 3.0 -- .gitignore
# =============================================================================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# === ROS2 ===
install/
log/
test_results/
build/
.colcon/
*.pyc

# === PlatformIO ===
.pio/
.vscode/
.clang_complete
.gcc-flags.json

# === Simulation ===
*.bag
*.db3
*.mcap
simulation/worlds/*.pcd

# === OS ===
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# === Logs ===
*.log

# === Secrets ===
config/secrets.yaml
*.pem
*.key
.env

# === IDE ===
.idea/
*.sublime-*
.vs/
.venv/

# === CAD / 3D Printing ===
# STL mesh files — globally ignored (too large)
# EXCEPTION: Fusion 360 primary design STLs in advika_description/stl/
*.stl
!src/advika_description/stl/*.stl

# STEP mechanical files
*.step
*.stp

# Fusion 360 project files
*.f3d
*.f3z

# Inventor / AutoCAD
*.ipt
*.iam
*.dwg
*.dxf

# Blender
*.blend
*.blend1

# 3D printing slicer profiles
*.ini
*.cfg
*.prusa
*.creality

# Rendered images
*.png
*.jpg
!docs/images/*.png
!docs/images/*.jpg
!docs/pcb/*.png
!docs/pcb/*.jpg
# ROS2 mesh STLs (visual + collision)
!src/advika_model/meshes/visual/*.stl
!src/advika_model/meshes/collision/*.stl

# 3D scans / point clouds
*.ply
*.pcd
.claude/
